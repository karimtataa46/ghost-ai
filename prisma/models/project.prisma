enum ProjectStatus {
  DRAFT
  ARCHIVED
  DELETING // Set before the Liveblocks room is deleted; nobody can open the project from then on
}

model Project {
  id             String                @id @default(cuid())
  ownerId        String // Clerk user ID
  name           String
  description    String?
  status         ProjectStatus         @default(DRAFT)
  canvasJsonPath String? // Vercel Blob URL of the saved canvas JSON; null until the first save
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  collaborators  ProjectCollaborator[]
  taskRuns       TaskRun[]
  specs          ProjectSpec[]

  @@index([ownerId])
  @@index([createdAt])
}

model ProjectCollaborator {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([projectId, email])
  @@index([email])
  @@index([projectId, createdAt])
}
